#!/usr/bin/env bash
# goose-sandbox — thin Bash dispatcher
# Sources lib/*.sh modules and dispatches to the appropriate function.
# Final `exec docker` call for the core runner lives here.

set -euo pipefail

LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib"

# Source all modules
source "$LIB_DIR/config.sh"
source "$LIB_DIR/install.sh"
source "$LIB_DIR/update.sh"
source "$LIB_DIR/recipe.sh"
source "$LIB_DIR/skills.sh"
source "$LIB_DIR/doctor.sh"

# Allow `source goose-sandbox` (e.g. the bats test harness) to load the
# function definitions and top-level defaults without running the CLI.
[[ "${BASH_SOURCE[0]}" != "$0" ]] && return 0

case "${1:-}" in
    doctor)
        resolve_recipe
        doctor
        exit $?
        ;;
    install)
        shift
        cmd_install "$@"
        exit $?
        ;;
    update)
        shift
        cmd_update "$@"
        exit $?
        ;;
    version)
        cmd_version
        exit $?
        ;;
    recipe)
        shift
        cmd_recipe "$@"
        exit $?
        ;;
    skills)
        shift
        cmd_skills "$@"
        exit $?
        ;;
    -h|--help|help)
        usage
        exit 0
        ;;
esac

# --- default: run a goose session ---------------------------------------
check_workspace || exit 1

if [[ ! -f "$ENV_FILE" ]]; then
    fail "Environment file not found: $ENV_FILE"
    exit 1
fi

ensure_state_dir
resolve_recipe

# --- Recipe image -------------------------------------------------------
if [[ -n "$RECIPE" ]]; then
    if ! docker image inspect "$BASE_IMAGE" >/dev/null 2>&1; then
        fail "Base image not found: $BASE_IMAGE"
        fail "Build it first from this repo: docker build -t '$BASE_IMAGE' ."
        exit 1
    fi

    if [[ -z "${GOOSE_SANDBOX_IMAGE:-}" ]]; then
        IMAGE="$(project_tag)"
    fi

    if [[ "$REBUILD" == "1" ]] || ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
        ok "Building recipe image: $IMAGE"
        docker build -f "$RECIPE" -t "$IMAGE" "$RECIPE_DIR"
    else
        ok "Using recipe image: $IMAGE"
    fi
fi

DOCKER_ARGS=(
    run
    --rm
    -it
    --init
    --security-opt=no-new-privileges:true
    --cap-drop=ALL
    --pids-limit="$PIDS"
    --memory="$MEMORY"
    --env-file "$ENV_FILE"
    --mount "type=bind,src=$WORKSPACE,dst=/workspace"
    --mount "type=bind,src=$STATE_DIR,dst=/goose-state"
    "--tmpfs=/workspace/.goose-sandbox:rw,noexec,nosuid,nodev,size=512m"
    --workdir /workspace
)

# --- Skills (mounted, never copied) -------------------------------------
mkdir -p "$GLOBAL_SKILLS"
DOCKER_ARGS+=(--mount "type=bind,src=$GLOBAL_SKILLS,dst=/home/goose/.agents/skills")

if [[ -n "$RECIPE" ]]; then
    PROJECT_SKILLS="$RECIPE_DIR/skills"
else
    PROJECT_SKILLS="$STATE_DIR/skills"
fi
if [[ -d "$PROJECT_SKILLS" ]]; then
    DOCKER_ARGS+=(--mount "type=bind,src=$PROJECT_SKILLS,dst=/workspace/.goose/skills")
fi

# --- MCP servers (--with-extension flags) -------------------------------
MCP_ARGS=()
if [[ -n "$RECIPE" && -f "$RECIPE_DIR/mcp.txt" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" ]] && continue
        if [[ "$line" == http://* || "$line" == https://* ]]; then
            MCP_ARGS+=(--with-streamable-http-extension "$line")
        elif [[ "$line" == *=* ]]; then
            MCP_ARGS+=(--with-extension "${line%%=*}:${line#*=}")
        else
            MCP_ARGS+=(--with-extension "$line")
        fi
    done < "$RECIPE_DIR/mcp.txt"
fi

if [[ -n "$CPUS" ]]; then
    DOCKER_ARGS+=(--cpus="$CPUS")
fi

if [[ "$NETWORK" == "none" ]]; then
    DOCKER_ARGS+=(--network=none)
elif [[ "$NETWORK" != "default" && -n "$NETWORK" ]]; then
    DOCKER_ARGS+=(--network="$NETWORK")
fi

exec docker "${DOCKER_ARGS[@]}" "$IMAGE" session "${MCP_ARGS[@]}" "$@"