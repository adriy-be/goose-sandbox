#!/usr/bin/env bash
set -euo pipefail

IMAGE="${GOOSE_SANDBOX_IMAGE:-goose-agent}"
ENV_FILE="${GOOSE_SANDBOX_ENV_FILE:-$HOME/.config/goose-sandbox/.env}"
WORKSPACE="${GOOSE_SANDBOX_WORKSPACE:-$PWD}"
MEMORY="${GOOSE_SANDBOX_MEMORY:-8g}"
PIDS="${GOOSE_SANDBOX_PIDS:-512}"
CPUS="${GOOSE_SANDBOX_CPUS:-}"
NETWORK="${GOOSE_SANDBOX_NETWORK:-default}"
STATE_DIR="$WORKSPACE/.goose-sandbox"
RECIPE="${GOOSE_SANDBOX_RECIPE:-}"
REBUILD="${GOOSE_SANDBOX_REBUILD:-0}"

# The base image (FROM ... in a recipe). Built once from this repo's Dockerfile.
BASE_IMAGE="goose-agent"

usage() {
    cat <<'USAGE'
Usage:
  goose-sandbox [goose session arguments...]
  goose-sandbox doctor

Launcher settings (host environment):
  GOOSE_SANDBOX_IMAGE       Docker image (default: goose-agent)
  GOOSE_SANDBOX_ENV_FILE    Provider env file
  GOOSE_SANDBOX_WORKSPACE   Workspace to mount (default: $PWD)
  GOOSE_SANDBOX_MEMORY      Memory limit (default: 8g)
  GOOSE_SANDBOX_PIDS        PID limit (default: 512)
  GOOSE_SANDBOX_CPUS        Optional CPU limit, e.g. 4
  GOOSE_SANDBOX_NETWORK     Docker network; use "none" to disable networking
  GOOSE_SANDBOX_RECIPE      Project recipe Dockerfile
                            (default: .goose-sandbox/recipe/Dockerfile
                             or .goose-sandbox/recipe.dockerfile)
  GOOSE_SANDBOX_REBUILD     1 to force rebuilding the recipe image
USAGE
}

ok()   { printf '✓ %s\n' "$*"; }
warn() { printf '⚠ %s\n' "$*"; }
fail() { printf '✗ %s\n' "$*" >&2; }

check_workspace() {
    if [[ ! -d "$WORKSPACE" ]]; then
        fail "Workspace does not exist: $WORKSPACE"
        return 1
    fi

    if [[ ! -w "$WORKSPACE" ]]; then
        fail "Workspace is not writable: $WORKSPACE"
        return 1
    fi

    return 0
}

ensure_state_dir() {
    mkdir -p "$STATE_DIR"
}

env_permissions() {
    local mode=""

    if command -v stat >/dev/null 2>&1; then
        mode="$(stat -c '%a' "$ENV_FILE" 2>/dev/null || stat -f '%Lp' "$ENV_FILE" 2>/dev/null || true)"
    fi

    if [[ -z "$mode" ]]; then
        warn "Could not inspect env-file permissions"
        return 0
    fi

    # Warn when group/other permissions are not zero.
    if (( 10#$mode % 100 != 0 )); then
        warn "Environment file permissions are $mode; recommended: chmod 600 '$ENV_FILE'"
    else
        ok "Environment file permissions: $mode"
    fi
}

doctor() {
    local failed=0

    if command -v docker >/dev/null 2>&1; then
        ok "Docker installed"
    else
        fail "Docker command not found"
        failed=1
    fi

    if (( failed == 0 )); then
        if docker info >/dev/null 2>&1; then
            ok "Docker daemon reachable"
        else
            fail "Docker daemon is not reachable"
            failed=1
        fi
    fi

    if [[ -f "$ENV_FILE" ]]; then
        ok "Environment file found: $ENV_FILE"
        env_permissions
    else
        fail "Environment file not found: $ENV_FILE"
        failed=1
    fi

    if check_workspace; then
        ok "Workspace writable: $WORKSPACE"
        if ensure_state_dir && [[ -w "$STATE_DIR" ]]; then
            ok "Goose state writable: $STATE_DIR"
        else
            fail "Goose state is not writable: $STATE_DIR"
            failed=1
        fi
    else
        failed=1
    fi

    local target="$IMAGE"
    if [[ -n "$RECIPE" ]] || [[ -f "$STATE_DIR/recipe/Dockerfile" ]] || [[ -f "$STATE_DIR/recipe.dockerfile" ]]; then
        local slug
        slug="$(basename "$WORKSPACE" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9._-' '-')"
        if [[ -z "${GOOSE_SANDBOX_IMAGE:-}" ]]; then
            target="goose-agent:$slug"
        fi
        ok "Recipe found; image will be: $target"
    fi

    if command -v docker >/dev/null 2>&1 && docker image inspect "$target" >/dev/null 2>&1; then
        ok "Image found: $target"
    else
        warn "Image not found locally: $target"
        warn "Base image:   docker build -t 'goose-agent' .   (in this repo)"
        if [[ -n "$RECIPE" ]] || [[ -f "$STATE_DIR/recipe/Dockerfile" ]] || [[ -f "$STATE_DIR/recipe.dockerfile" ]]; then
            warn "Recipe image: goose-sandbox will build it on next launch"
        else
            warn "Build it with: docker build -t '$target' ."
        fi
    fi

    printf '\nWorkspace: %s\n' "$WORKSPACE"
    printf 'Image:     %s\n' "$target"
    printf 'Memory:    %s\n' "$MEMORY"
    printf 'PIDs:      %s\n' "$PIDS"
    printf 'Network:   %s\n' "$NETWORK"

    if [[ -n "$CPUS" ]]; then
        printf 'CPUs:      %s\n' "$CPUS"
    fi

    if (( failed != 0 )); then
        printf '\nNot ready. Fix the errors above.\n' >&2
        return 1
    fi

    printf '\nReady.\n'
}

# Resolve the recipe Dockerfile (if any) and the directory that holds it.
# The recipe directory is where skills/ and mcp.txt live.
resolve_recipe() {
    if [[ -z "$RECIPE" ]]; then
        if [[ -f "$STATE_DIR/recipe.dockerfile" ]]; then
            RECIPE="$STATE_DIR/recipe.dockerfile"
        elif [[ -f "$STATE_DIR/recipe/Dockerfile" ]]; then
            RECIPE="$STATE_DIR/recipe/Dockerfile"
        fi
    fi
    if [[ -z "$RECIPE" ]]; then
        RECIPE_DIR=""
    else
        RECIPE_DIR="$(cd "$(dirname "$RECIPE")" && pwd)"
    fi
}

case "${1:-}" in
    doctor)
        resolve_recipe
        doctor
        exit $?
        ;;
    -h|--help|help)
        usage
        exit 0
        ;;
esac

check_workspace || exit 1

if [[ ! -f "$ENV_FILE" ]]; then
    fail "Environment file not found: $ENV_FILE"
    exit 1
fi

ensure_state_dir
resolve_recipe

# --- Recipe image -------------------------------------------------------
# When a project defines a recipe, build a project-specific image on top
# of the base image and run that instead of the base directly.
if [[ -n "$RECIPE" ]]; then
    if ! docker image inspect "$BASE_IMAGE" >/dev/null 2>&1; then
        fail "Base image not found: $BASE_IMAGE"
        fail "Build it first from this repo: docker build -t '$BASE_IMAGE' ."
        exit 1
    fi

    local_slug="$(basename "$WORKSPACE" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9._-' '-')"
    if [[ -z "${GOOSE_SANDBOX_IMAGE:-}" ]]; then
        IMAGE="goose-agent:$local_slug"
    fi

    if [[ "$REBUILD" == "1" ]] || ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
        ok "Building recipe image: $IMAGE"
        docker build -f "$RECIPE" -t "$IMAGE" "$RECIPE_DIR"
    else
        ok "Using recipe image: $IMAGE"
    fi
fi

# --- Skills (mounted, never copied) -------------------------------------
# Mount a host skills directory over the goose global skills path so any
# skill installed during a session is written straight back to the host
# directory and persists between sessions.
GOOSE_SKILLS_DIR="/home/goose/.agents/skills"
SKILLS_MOUNT=""
if [[ -n "$RECIPE" ]]; then
    HOST_SKILLS="$RECIPE_DIR/skills"
else
    HOST_SKILLS="$STATE_DIR/skills"
fi
mkdir -p "$HOST_SKILLS"
SKILLS_MOUNT="type=bind,src=$HOST_SKILLS,dst=$GOOSE_SKILLS_DIR"

# --- MCP servers (--with-extension flags) -------------------------------
# mcp.txt lives next to the recipe: one server per line, "name=command".
# http(s):// lines become --with-streamable-http-extension.
MCP_ARGS=()
if [[ -n "$RECIPE" && -f "$RECIPE_DIR/mcp.txt" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" ]] && continue
        if [[ "$line" == http://* || "$line" == https://* ]]; then
            MCP_ARGS+=(--with-streamable-http-extension "$line")
        elif [[ "$line" == *=* ]]; then
            MCP_ARGS+=(--with-extension "${line%%=*}:${line#*=}")
        else
            MCP_ARGS+=(--with-extension "$line")
        fi
    done < "$RECIPE_DIR/mcp.txt"
fi

DOCKER_ARGS=(
    run
    --rm
    -it
    --init
    --security-opt=no-new-privileges:true
    --cap-drop=ALL
    --pids-limit="$PIDS"
    --memory="$MEMORY"
    --env-file "$ENV_FILE"
    --mount "type=bind,src=$WORKSPACE,dst=/workspace"
    --mount "type=bind,src=$STATE_DIR,dst=/goose-state"
    --mount "$SKILLS_MOUNT"
    "--tmpfs=/workspace/.goose-sandbox:rw,noexec,nosuid,nodev,size=512m"
    --workdir /workspace
)

if [[ -n "$CPUS" ]]; then
    DOCKER_ARGS+=(--cpus="$CPUS")
fi

if [[ "$NETWORK" == "none" ]]; then
    DOCKER_ARGS+=(--network=none)
elif [[ "$NETWORK" != "default" && -n "$NETWORK" ]]; then
    DOCKER_ARGS+=(--network="$NETWORK")
fi

exec docker "${DOCKER_ARGS[@]}" "$IMAGE" session "${MCP_ARGS[@]}" "$@"
