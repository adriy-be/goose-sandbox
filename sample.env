# -------------------------------------------------------------------
# Goose sandboxed environment
# -------------------------------------------------------------------

# --- Provider -------------------------------------------------------

GOOSE_PROVIDER=openai
GOOSE_MODEL=deepseek-ai/DeepSeek-V3

# DeepInfra
OPENAI_HOST=https://api.deepinfra.com
OPENAI_API_KEY=YOUR_DEEPINFRA_API_KEY

# OpenAI-compatible API path used by DeepInfra
OPENAI_BASE_PATH=v1/openai/chat/completions


# --- Fast model -----------------------------------------------------

# Do NOT define this as empty.
# Uncomment only when you actually want another model.
# GOOSE_FAST_MODEL=deepseek-ai/DeepSeek-V3


# --- Tool execution safety -----------------------------------------

# auto          = tools execute automatically
# approve       = ask before tool execution
# chat          = no tools
# smart_approve = selective approval
GOOSE_MODE=approve


# --- CLI ------------------------------------------------------------

# GOOSE_CLI_SHOW_THINKING=1
GOOSE_CLI_SHOW_COST=true