# -------------------------------------------------------------------
# Goose sandboxed environment
# Copy to: ~/.config/goose-sandbox/.env
# Then: chmod 600 ~/.config/goose-sandbox/.env
# -------------------------------------------------------------------

# --- Provider -------------------------------------------------------
GOOSE_PROVIDER=openai
GOOSE_MODEL=deepseek-ai/DeepSeek-V3

# DeepInfra (OpenAI-compatible API)
OPENAI_HOST=https://api.deepinfra.com
OPENAI_API_KEY=YOUR_DEEPINFRA_API_KEY
OPENAI_BASE_PATH=v1/openai/chat/completions

# --- Fast model -----------------------------------------------------
# Do NOT define this as empty.
# GOOSE_FAST_MODEL=deepseek-ai/DeepSeek-V3

# --- Tool execution safety -----------------------------------------
# auto          = tools execute automatically
# approve       = ask before tool execution
# chat          = no tools
# smart_approve = selective approval
GOOSE_MODE=approve

# --- Security / privacy --------------------------------------------
# Goose documents telemetry as disabled by default. Keep it explicit here.
GOOSE_TELEMETRY_ENABLED=false

# Optional Goose prompt-injection detection.
# SECURITY_PROMPT_ENABLED=true

# --- CLI ------------------------------------------------------------
# GOOSE_CLI_SHOW_THINKING=1
GOOSE_CLI_SHOW_COST=true

# Launcher-only options such as GOOSE_SANDBOX_MEMORY are host environment
# variables. They are intentionally not stored in this provider credential file.
